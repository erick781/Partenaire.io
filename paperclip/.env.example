# ============================================================
# Paperclip AI — Environment Variables for Partenaire.io
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# --- Paperclip Server ---
PAPERCLIP_INSTANCE_ID=partenaire-ops
PAPERCLIP_PORT=3100

# --- Anthropic (Claude API for agents) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Stripe (Revenue & Invoicing) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- PandaDoc (Contracts & Proposals) ---
PANDADOC_API_KEY=...

# --- Supabase (Bridge to Command Center) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Service role key is used by Paperclip agents to write to ops_* tables.
# This key bypasses RLS — keep it secret.

# --- Slack (Alert Notifications) ---
SLACK_OPS_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- SMS Alerts (P0 Critical — via Twilio) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+1...
BOARD_PHONE_NUMBER=+1...

# --- Optional: Ad Platform APIs (for spend tracking) ---
# META_ACCESS_TOKEN=...
# META_AD_ACCOUNT_ID=act_...
# TIKTOK_ACCESS_TOKEN=...
# GOOGLE_ADS_DEVELOPER_TOKEN=...
